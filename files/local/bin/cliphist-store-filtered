#!/usr/bin/env python3

# Tries to ignore emoji-only clipboard entries and only save non-emoji text to cliphist.

import subprocess
import sys
import unicodedata

raw = sys.stdin.buffer.read()

# Ignore whitespace-only clipboard data.
if not raw.strip():
    sys.exit(0)

# This script is intentionally text-only for Sway clipboard usage.
# Reject null bytes and non-UTF-8 data rather than trying to store them.
if b"\0" in raw:
    sys.exit(0)

try:
    text = raw.decode("utf-8")
except UnicodeDecodeError:
    sys.exit(0)

trimmed = text.strip()
if trimmed and len(trimmed) <= 10 and all(
    unicodedata.category(ch) in ("So", "Sk", "Cf", "Mn") or ord(ch) in (0x200D, 0xFE0F)
    for ch in trimmed
):
    sys.exit(0)

subprocess.run(["cliphist", "store"], input=raw, check=True)